#!/usr/bin/env bash
#
# Build the Docker image used to inspect suiteDeveloperBase on Linux.

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
harness_dir="$(cd -- "$script_dir/.." && pwd)"
image_name="${DOTFILES_NIX_DEVSUITE_IMAGE:-dotfiles-nix-devsuite:latest}"

docker build \
  --tag "$image_name" \
  --file "$harness_dir/Dockerfile" \
  "$harness_dir"
