FROM nixos/nix:latest

SHELL ["/bin/sh", "-eu", "-c"]

# The official Nix image is not a NixOS image. It is a minimal Nix runtime, so
# keep setup at container scope: install the tiny tools needed by the entrypoint
# and add a disposable Unix account for Home Manager to target.
RUN nix --extra-experimental-features "nix-command flakes" profile add \
    nixpkgs#util-linux

# The base image keeps passwd/group as immutable Nix store files. Materialize
# writable container-local copies, append one inspection user, and create its
# home. No NixOS activation is involved here; this is just Docker image setup.
RUN cp -L /etc/passwd /tmp/passwd && \
  cp -L /etc/group /tmp/group && \
  cp --remove-destination /tmp/passwd /etc/passwd && \
  cp --remove-destination /tmp/group /etc/group && \
  printf 'testuser:x:1000:1000:Test User:/home/testuser:/bin/sh\n' >> /etc/passwd && \
  printf 'testuser:x:1000:\n' >> /etc/group && \
  install -d -m 0755 -o 1000 -g 1000 /home/testuser

# Docker exec sessions inherit the image environment. Include the future Home
# Manager profile path so interactive exec shells resolve profile-installed
# tools once activation has completed.
ENV PATH="/home/testuser/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/bin"
ENV NIX_PROFILES="/nix/var/nix/profiles/default /home/testuser/.nix-profile"

COPY entrypoint.sh /usr/local/bin/dotfiles-nix-test-suite-entrypoint
RUN chmod 0755 /usr/local/bin/dotfiles-nix-test-suite-entrypoint

ENTRYPOINT ["/usr/local/bin/dotfiles-nix-test-suite-entrypoint"]
CMD ["sleep", "infinity"]
