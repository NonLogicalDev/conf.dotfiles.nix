FROM nixos/nix:latest

SHELL ["/bin/sh", "-eu", "-c"]

COPY configuration.nix /etc/nixos/configuration.nix

# Build and activate a tiny static NixOS container substrate. `switch` assumes
# it is running on an existing NixOS machine, while this image starts from the
# lean nixos/nix base. Building the system and running its activation script
# gives us NixOS-owned users, shell paths, and Nix daemon tooling without
# hand-editing account databases.
RUN nix --extra-experimental-features "nix-command flakes" run nixpkgs#nixos-rebuild -- \
    build \
    -I nixos-config=/etc/nixos/configuration.nix && \
  mkdir -p /run && \
  ./result/activate && \
  ln -sfn "$(readlink -f ./result)" /run/current-system

# Docker exec sessions inherit the image environment rather than the entrypoint
# process environment. Model the baseline profile paths that a normal Nix login
# environment would provide so interactive shells can find Home Manager
# packages after the profile is activated.
ENV PATH="/home/testuser/.nix-profile/bin:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:/bin"
ENV NIX_PROFILES="/run/current-system/sw /nix/var/nix/profiles/default /home/testuser/.nix-profile"

COPY entrypoint.sh /usr/local/bin/dotfiles-nix-test-suite-entrypoint
RUN chmod 0755 /usr/local/bin/dotfiles-nix-test-suite-entrypoint

ENTRYPOINT ["/usr/local/bin/dotfiles-nix-test-suite-entrypoint"]
CMD ["sleep", "infinity"]
