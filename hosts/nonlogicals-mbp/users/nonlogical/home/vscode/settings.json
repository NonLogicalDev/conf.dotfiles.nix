{
    "window.experimental.commandCenter": true,

    "files.trimTrailingWhitespace": true,
    "files.autoSave": "onFocusChange",
    "files.exclude": {
        "**/.tmp": true,
        "vendor": true,
        "**/.git": true,
        "**/.DS_Store": true,
        "go-build/.go": true, "**/*.test": true, "Godeps/_workspace": true,
        "**/coverage.html": true,
        "**/_build": true
    },

    "editor.fontFamily": "Monaco, Menlo, monospace",
    "editor.lineHeight": 18,
    "editor.fontSize": 14,
    "editor.fontLigatures": false,
    "editor.formatOnType": true,
    "editor.scrollBeyondLastLine": false,
    "editor.cursorSmoothCaretAnimation": "on",

    "terminal.integrated.fontSize": 14,

    "workbench.tree.indent": 20,
    "workbench.tree.renderIndentGuides": "always",
    "workbench.fontAliasing": "auto",
    "workbench.list.multiSelectModifier": "alt",
    "workbench.list.keyboardNavigation": "filter",

    "workbench.iconTheme": "vscode-icons",
    "workbench.colorTheme": "Copilot Theme",

    "workbench.colorCustomizations": {









    },

    "oneDarkPro.italic": false,


    "vim.easymotion": true,
    "vim.foldfix": true,
    "vim.leader": " ",
    "vim.visualstar": true,
    "vim.enableNeovim": true,
    "vim.highlightedyank.enable": true,

    "vim.insertModeKeyBindings": [
        { "before": ["up"], "after": ["<C-o>", "g", "k"] },
        { "before": ["down"], "after": ["<C-o>", "g", "j"] },
    ],
    "vim.normalModeKeyBindings": [
        { "before": ["k"], "after": ["g", "k"] },
        { "before": ["j"], "after": ["g", "j"] },
    ],

    "gitlens.views.repositories.files.layout": "tree",

    "diffEditor.ignoreTrimWhitespace": true,
    "diffEditor.renderSideBySide": true,


    "typescript.updateImportsOnFileMove.enabled": "always",
    "javascript.updateImportsOnFileMove.enabled": "always",

    "python.jediEnabled": false,

    "[go]": {
        "editor.formatOnSave": false
    },

    "go.gopath": "${env:HOME}/go",
    "go.toolsGopath": "${env:HOME}/go",
    "go.formatTool": "gofmt",
    "gopls": {
        "formatting.gofumpt": false,
    },
    "go.useLanguageServer": true,
    "go.useCodeSnippetsOnFunctionSuggest": true,
    "go.trace.server": "verbose",

    "platformio-ide.disablePIOHomeStartup": true,
    "python.languageServer": "Default",

    "workbench.editorAssociations": {
        "*.ipynb": "jupyter.notebook.ipynb"
    },
    "yaml.customTags": [
        "!encrypted/pkcs1-oaep scalar",
        "!vault scalar"
    ],
    "editor.tabSize": 4,
    "editor.cursorStyle": "line",
    "editor.insertSpaces": false,
    "editor.lineNumbers": "on",
    "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
    "editor.wordWrap": "off",
    "redhat.telemetry.enabled": false,
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "calva.paredit.defaultKeyMap": "strict",
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "security.workspace.trust.untrustedFiles": "open",
    "notebook.lineNumbers": "on",
    "notebook.output.textLineLimit": 50,
    "editor.inlineSuggest.enabled": true,
    "terminal.integrated.copyOnSelection": true,
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask"
    ],
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false
    },
}
